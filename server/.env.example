# Server runtime
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Auth cookie signing secret — replace in real use
JWT_SECRET=dev-only-change-me

# Neon pooled endpoint (contains -pooler) — used by the running app
DATABASE_URL=

# Neon direct endpoint (no -pooler) — used only by drizzle-kit migrations
DATABASE_URL_DIRECT=

# Hours an unsaved document stays reachable through its share link.
# Deadline is pushed forward on every edit; Save clears the expiry entirely.
LINK_RETENTION_HOURS=24

# How often active (dirty) document sessions are checkpointed to PostgreSQL (seconds).
RETENTION_CHECKPOINT_SECONDS=30

# How often the expiry sweep job runs to delete unsaved documents whose expires_at has passed (seconds).
EXPIRY_SWEEP_SECONDS=60
