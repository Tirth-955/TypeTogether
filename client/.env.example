# Backend origin for REST + Socket.IO calls.
# Leave both unset in local dev (the Vite proxy handles /api and /socket.io).
# On Vercel, set BOTH to your Render server origin (no trailing slash):

VITE_API_URL=https://typetogether-api.onrender.com

VITE_SOCKET_URL=https://typetogether-api.onrender.com
